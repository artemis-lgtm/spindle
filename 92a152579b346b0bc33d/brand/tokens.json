{
  "brand": "Spindle",
  "alternates": [
    "Side A",
    "Deadwax"
  ],
  "color": {
    "vinyl": "#16130F",
    "soot": "#2B2622",
    "plaster": "#E9DFCF",
    "label": "#F4ECDD",
    "halo": "#F0A43B",
    "ember": "#B9661C",
    "chrome": "#C7CBD0",
    "chrome_deep": "#5F6468",
    "brass": "#B7955B"
  },
  "font": {
    "display": {
      "family": "Inter Tight",
      "weights": [
        500,
        600,
        700
      ],
      "source": "https://fonts.google.com/specimen/Inter+Tight",
      "license": "OFL",
      "use": "Wordmark (600, +0.06em caps), headlines (600, -0.02em), UI and body (400/500)"
    },
    "editorial": {
      "family": "Instrument Serif",
      "weights": [
        400,
        "400 italic"
      ],
      "source": "https://fonts.google.com/specimen/Instrument+Serif",
      "license": "OFL",
      "use": "Taglines, the ritual line, pull quotes. Italic, large, never below 20px"
    },
    "mono": {
      "family": "JetBrains Mono",
      "weights": [
        400,
        500
      ],
      "source": "https://fonts.google.com/specimen/JetBrains+Mono",
      "license": "OFL",
      "use": "Specs, serials, finish codes, labels: the deadwax etching voice. Caps, +0.18 to +0.22em"
    },
    "licensed_alternatives": {
      "display": "S\u00f6hne (Klim) or Neue Haas Grotesk",
      "editorial": "GT Alpina (Grilli) or Canela (Commercial Type)",
      "mono": "S\u00f6hne Mono (Klim) or Berkeley Mono"
    }
  },
  "type_scale_px": {
    "display": 64,
    "h1": 44,
    "h2": 32,
    "h3": 24,
    "body": 17,
    "small": 14,
    "meta": 12
  },
  "letter_spacing_em": {
    "display": -0.02,
    "h1": -0.015,
    "body": 0,
    "caps_meta": 0.2,
    "wordmark": 0.06
  },
  "radius_px": {
    "card": 6,
    "button": 999,
    "image": 8
  },
  "space_px": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96,
    128
  ],
  "rules": [
    "One accent only (Halo). It appears as light, not as a fill: glows, hairline rules, a single word.",
    "Warm neutrals only. No pure white and no pure black in print; Label and Vinyl are the extremes.",
    "Chrome colours are for hardware and metadata, never for headlines.",
    "Brass is a finish swatch in the configurator and nowhere else."
  ]
}